package perch:plugin@0.1.0;

/// The only thing a plugin may call on the host. This task wires no IO, so a
/// plugin that wants a file has no import to ask through.
interface log {
    log: func(message: string);
}

/// What a plugin contributes to the tool registry.
interface tools {
    /// One tool the model may call. `parameters-json` is a JSON Schema object
    /// serialised as text, because WIT has no JSON type.
    record tool-spec {
        name: string,
        description: string,
        parameters-json: string,
    }

    /// Every tool this plugin registers, discovered once at load time.
    tool-specs: func() -> list<tool-spec>;

    /// Runs one tool. The error string is the message the model sees.
    call: func(name: string, args-json: string) -> result<string, string>;
}

/// The panel a plugin shows in the app.
///
/// The model is data only: text, rows of text, named buttons and named inputs. The host owns
/// layout, theme and hit-testing and reads the model on every frame it draws, so a plugin can
/// add content but has no way to draw over the app's chrome.
interface panels {
    /// A button the host draws; `id` is what a press is reported back with.
    record panel-button {
        id: string,
        label: string,
    }

    /// A text field the host draws; `id` is what a submit is reported back with.
    record panel-input {
        id: string,
        label: string,
    }

    /// One piece of a panel, in the order the host draws it.
    variant panel-section {
        text(string),
        rows(list<string>),
        button(panel-button),
        input(panel-input),
    }

    /// A plugin's whole panel: a title and its sections.
    record panel-model {
        title: string,
        sections: list<panel-section>,
    }

    /// The panel to draw now.
    panel: func() -> panel-model;

    /// One session event, as the JSON the host serialised it to.
    on-event: func(event-json: string);
}

/// What the host reports back to a plugin: a press on a control its panel declared.
///
/// One function rather than one per control kind, so a plugin answers every control in one place
/// and a new kind of control does not widen the ABI again. `value` is what an input was submitted
/// with; a button press has none, because a button has nothing to say.
interface actions {
    /// A press on the control `id`, with the text a person submitted when it is an input.
    action: func(id: string, value: option<string>);
}

world perch-plugin {
    import log;
    export tools;
    export panels;
    export actions;
}
